# Firebase web app config (Project settings → Your apps → Web app). These values are not secret.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Local development without a Firebase project: run `npm run emulators` and set the host
# (localhost for web, your computer's LAN IP for a phone with Expo Go).
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=localhost
