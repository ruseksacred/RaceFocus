{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (data.exists() ? data.child('hostId').val() === auth.uid : newData.child('hostId').val() === auth.uid)",
        ".validate": "!newData.exists() || newData.hasChildren(['hostId', 'rules', 'status', 'createdAt'])",
        "hostId": {
          ".validate": "newData.isString()"
        },
        "status": {
          ".validate": "newData.val() === 'lobby' || newData.val() === 'racing' || newData.val() === 'finished'"
        },
        "seed": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "startAt": {
          ".validate": "newData.isNumber()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "rules": {
          "track": {
            ".validate": "newData.val() === 'sprint' || newData.val() === 'street' || newData.val() === 'circuit' || newData.val() === 'endurance'"
          },
          "mode": {
            ".validate": "newData.val() === 'ascending' || newData.val() === 'descending'"
          },
          "laps": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99"
          },
          "penaltyMs": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
          },
          "maxPlayers": {
            ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 12"
          },
          "lengthKind": {
            ".validate": "newData.val() === 'laps' || newData.val() === 'time'"
          },
          "minutes": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 30"
          },
          "quick": {
            ".validate": "newData.isBoolean()"
          },
          "dnfMistakes": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
          },
          "$other": {
            ".validate": false
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (data.exists() || root.child('rooms').child($code).child('status').val() === 'lobby')",
            ".validate": "!newData.exists() || newData.hasChildren(['name', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "mistakes": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "retired": {
              ".validate": "newData.isBoolean()"
            },
            "crossings": {
              "$i": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              }
            },
            "rating": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
            },
            "helmet": {
              ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().matches(/^[a-z]+\\.[a-z]+\\.[a-z]+\\.[0-9]{1,2}$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "queue": {
      "quick": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous'",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
          ".validate": "!newData.exists() || newData.hasChildren(['nick', 'rating', 'joinedAt'])",
          "nick": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "rating": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
          },
          "joinedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "helmet": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "match": {
            ".write": "auth != null && auth.uid !== $uid && auth.token.firebase.sign_in_provider !== 'anonymous' && !data.exists() && data.parent().exists() && newData.isString() && root.child('queue').child('quick').child(auth.uid).child('match').val() === newData.val()",
            ".validate": "newData.isString() && newData.val().length <= 8"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "leaderboards": {
      "$board": {
        ".read": "auth != null",
        ".indexOn": ["ms"],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous' && $board.matches(/^(sprint|street|circuit|endurance)_(ascending|descending)$/)",
          ".validate": "newData.hasChildren(['name', 'ms', 'at']) && (!data.exists() || newData.child('ms').val() <= data.child('ms').val())",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "ms": {
            ".validate": "newData.isNumber() && newData.val() >= 450 && newData.val() < 3600000"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "helmet": {
            ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().matches(/^[a-z]+\\.[a-z]+\\.[a-z]+\\.[0-9]{1,2}$/)"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "nicks": {
      "$key": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && (!newData.exists() || newData.val() === auth.uid)))",
        ".validate": "!newData.exists() || newData.isString()"
      }
    },
    "users": {
      "$uid": {
        "profile": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
          ".validate": "!newData.exists() || newData.hasChildren(['nick', 'rating', 'ratedRaces', 'updatedAt'])",
          "nick": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "rating": {
            ".validate": "newData.isNumber()"
          },
          "ratedRaces": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "data": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'"
        },
        ".write": "auth != null && auth.uid === $uid && !newData.exists()"
      }
    }
  }
}
